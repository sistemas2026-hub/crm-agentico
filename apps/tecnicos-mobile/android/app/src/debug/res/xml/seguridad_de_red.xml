<?xml version="1.0" encoding="utf-8"?>
<!--
  CONFIGURACIÓN DE DESARROLLO. Reemplaza a la de `src/main` solo en debug.

  Se permite HTTP en claro únicamente contra el equipo de quien programa:

  * `10.0.2.2` es el host visto desde el emulador de Android.
  * `localhost` y `127.0.0.1`, para cuando se usa `adb reverse tcp:8000`.

  No se agrega ninguna IP de red local ni ningún dominio: apuntar la
  aplicación a un servidor de verdad por HTTP tiene que seguir fallando, en
  esta variante también. Lo que se abre es el backend de desarrollo, no el
  hábito.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
