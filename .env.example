# Plantilla de configuracion. Copiar a .env y rellenar.
# El archivo .env real NO se versiona (ver .gitignore).
# La clave se genera en WispHub: Lista de Personal -> "Generar Mi APIKey"
WISPHUB_API_KEY=

# Modo de ejecucion:
#   false -> datos simulados, no toca la API (por defecto; recomendado para probar)
#   true  -> llama a WispHub de verdad (exige WISPHUB_API_KEY)
WISPHUB_MODO_REAL=false

# Opcional. Produccion por defecto: https://api.wisphub.io
WISPHUB_BASE_URL=https://api.wisphub.io

# Auditoria de accesos (RF-13). Activa por defecto.
# AUDITORIA_ACTIVA=true
# ARCHIVO_AUDITORIA=auditoria.log

# Opcional. Fija el area del colaborador y evita el menu al arrancar.
# Valores: soporte | tecnica | facturacion | administracion
# AREA_COLABORADOR=soporte

# Modelo que DECIDE la herramienta. Medido con banco_pruebas.py (agosto 2026):
#   qwen3:30b-a3b-q4_K_M -> 100% acierto. MoE: 30B totales, ~3B activos, asi que
#                           corre sin GPU. Mas lento por token que el 4b (11 vs
#                           52 tok/s) pero MAS RAPIDO por turno: razona con 658
#                           caracteres donde el 4b gasta 2.154.
#   qwen3:4b             -> 100% acierto tambien. Alternativa si falta memoria:
#                           pesa 2.5 GB contra 18 GB.
#   phi4-mini            -> NO USAR AQUI: 12.5% de acierto eligiendo herramienta.
MODELO_SLM=qwen3:30b-a3b-q4_K_M

# Modelo que REDACTA la respuesta final. Aqui el dato ya esta resuelto y no hay
# nada que razonar, asi que conviene uno SIN 'thinking': es donde se recupera
# la latencia sin perder fidelidad.
#   phi4-mini:latest -> medido: 100% fiel al dato, 100% RF-15, 0 razonamiento,
#                       3.1 s por turno. Recomendado.
#   gemma3:4b        -> NO USAR: ignora el dato de la herramienta y lo inventa.
MODELO_REDACCION=phi4-mini:latest

# Puerto donde escucha nucleo/canales/api.py (el motor expuesto por HTTP).
PUERTO_API=5000

# Persistencia local (SQLite -- ver nucleo/persistencia/db.py). Mismo esquema
# que supabase/01_schema.sql, para cuando exista un proyecto Supabase real.
RUTA_DB=datos/asistente.db

# BottleCRM (fuente de datos adicional, en integracion). El token se genera
# en BottleCRM: Settings -> API tokens. Mintear con scopes de solo lectura
# (ej. scopes: ["cases:read"]) -- sin scopes declarados el token queda con
# acceso total de lectura/escritura, que no es lo que necesita esta integracion.
BOTTLECRM_BASE_URL=http://localhost:8000
BOTTLECRM_API_TOKEN=

# -----------------------------------------------------------------------------
#  BASE DE DATOS  (Supabase auto-hospedado)
# -----------------------------------------------------------------------------
# UNA sola fuente para toda la plataforma. Django las lee con estos mismos
# nombres (django-crm/backend/crm/settings.py) y nucleo/persistencia/conexion.py
# compone con ellas la cadena que usan el motor y las utilidades de cli/.
#
# Si se dejan vacias, el docker-compose.yml de desarrollo cae a sus valores por
# defecto y todo apunta al Postgres local del compose ('db'), desechable.
#
# DBUSER lleva el sufijo del tenant porque lo exige Supavisor, el pooler:
# conectar como 'postgres' a secas devuelve ENOIDENTIFIER.
# DBPORT 5433 = modo session. El 6544 es transaction, que multiplexa conexiones
# y rompe las sentencias preparadas de psycopg y de Django.
DBHOST=
DBPORT=5433
DBNAME=postgres
DBUSER=postgres.<tenant-id-del-pooler>
DBPASSWORD=

# Clave del modelo en la nube. Todos los roles estan enrutados a DeepSeek; ver
# la seccion 'llm' del YAML del tenant y RNF-01 del PRD para la base legal.
DEEPSEEK_API_KEY=

# Solo para 'rol:supervisor' (llm.overrides en el YAML del tenant) -- la
# revision automatica de conversaciones cerradas corre en segundo plano, sin
# la urgencia de latencia de responderle a un cliente en vivo, asi que usa un
# modelo mas deliberado (Claude) en vez de DeepSeek.
ANTHROPIC_API_KEY=
