# Docker development environment variables
# Copy to .env.docker.local and customize if needed

# Django
SECRET_KEY=django-insecure-docker-dev-key-change-in-production
DEBUG=True
ENV_TYPE=dev
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DOMAIN_NAME=http://localhost:8000

# Database (must match docker-compose db service)
DBNAME=crm_db
DBUSER=crm_user
DBPASSWORD=crm_password
DBHOST=db
DBPORT=5432

# Postgres superuser (used by db service to create the database)
POSTGRES_DB=crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (console backend in dev: emails print to stdout)
DEFAULT_FROM_EMAIL=noreply@localhost
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin

# CORS
CORS_ALLOW_ALL=True

# Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
# PUBLIC_* is what the BROWSER uses (reaches the backend via the port
# published on the host, localhost:8000). Server-side code running INSIDE
# the frontend container (+page.server.js, form actions) must NOT use this
# one -- from inside that container "localhost" means the frontend
# container itself, nothing listens on :8000 there. Use PRIVATE_DJANGO_API_URL
# (the compose service name, same-network DNS) for any fetch that happens
# in server-side code.
PUBLIC_DJANGO_API_URL=http://localhost:8000
PRIVATE_DJANGO_API_URL=http://backend:8000
