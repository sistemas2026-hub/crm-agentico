{
  "id": "isp",
  "version": 1,
  "name": "Internet service provider",
  "description": "Home and business internet providers (fiber or fixed wireless): coverage request through installation, then day-to-day connectivity support.",
  "terminology": {
    "lead.singular": "Coverage request",
    "lead.plural": "Coverage requests",
    "opportunity.singular": "Installation",
    "opportunity.plural": "Installations",
    "account.singular": "Subscriber",
    "account.plural": "Subscribers"
  },
  "lead_pipeline": {
    "name": "New sign-ups",
    "description": "From a coverage request to an activated connection.",
    "stages": [
      { "name": "New request", "order": 1, "stage_type": "open", "color": "#6B7280" },
      { "name": "Coverage check", "order": 2, "stage_type": "open", "color": "#3B82F6" },
      { "name": "Site survey scheduled", "order": 3, "stage_type": "open", "color": "#6366F1" },
      { "name": "Quote sent", "order": 4, "stage_type": "open", "color": "#8B5CF6" },
      { "name": "Installed", "order": 5, "stage_type": "won", "color": "#10B981" },
      { "name": "No coverage", "order": 6, "stage_type": "lost", "color": "#EF4444" }
    ]
  },
  "case_pipeline": {
    "name": "Support tickets",
    "description": "Connectivity, equipment and billing issues raised by subscribers.",
    "stages": [
      { "name": "New", "order": 1, "stage_type": "open", "color": "#6B7280" },
      { "name": "Technician assigned", "order": 2, "stage_type": "open", "color": "#3B82F6" },
      { "name": "Awaiting subscriber", "order": 3, "stage_type": "open", "color": "#F59E0B" },
      { "name": "Resolved", "order": 4, "stage_type": "closed", "color": "#10B981" },
      { "name": "Not serviceable", "order": 5, "stage_type": "rejected", "color": "#EF4444" }
    ]
  },
  "task_pipeline": {
    "name": "Field work",
    "description": "Installs, repairs and site visits.",
    "stages": [
      { "name": "To do", "order": 1, "stage_type": "open", "color": "#6B7280" },
      { "name": "Scheduled", "order": 2, "stage_type": "open", "color": "#3B82F6" },
      { "name": "In progress", "order": 3, "stage_type": "in_progress", "color": "#8B5CF6" },
      { "name": "Done", "order": 4, "stage_type": "completed", "color": "#10B981" }
    ]
  },
  "custom_fields": [
    { "target": "Lead", "key": "service_address", "label": "Service address", "field_type": "text", "is_filterable": true, "display_order": 1 },
    { "target": "Lead", "key": "plan_interest", "label": "Plan of interest", "field_type": "dropdown", "is_filterable": true, "display_order": 2,
