    { "target": "Lead", "key": "coverage_zone", "label": "Coverage zone", "field_type": "text", "is_filterable": true, "display_order": 3 },
    { "target": "Lead", "key": "requested_install_date", "label": "Requested install date", "field_type": "date", "display_order": 4 },
    { "target": "Lead", "key": "switching_provider", "label": "Switching from another provider", "field_type": "checkbox", "display_order": 5 }
