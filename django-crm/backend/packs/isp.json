        { "value": "home_20", "label": "Home 20 Mbps" },
        { "value": "home_50", "label": "Home 50 Mbps" },
        { "value": "home_100", "label": "Home 100 Mbps" },
        { "value": "home_200", "label": "Home 200 Mbps" },
        { "value": "business_100", "label": "Business 100 Mbps dedicated" }
