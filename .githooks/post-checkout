#!/bin/sh
# Mismo aviso que post-merge, pero al cambiar de rama (git checkout / switch).
PREV=$1
NUEVO=$2
ES_CAMBIO_DE_RAMA=$3

[ "$ES_CAMBIO_DE_RAMA" = "1" ] || exit 0

CAMBIADOS=$(git diff --name-only "$PREV" "$NUEVO" -- PRD.md ARQUITECTURA.md 2>/dev/null)

if [ -n "$CAMBIADOS" ]; then
    echo ""
    echo "================================================================"
    echo "  Esta rama tiene una version distinta de:"
    echo "$CAMBIADOS" | sed 's/^/    - /'
    echo "  Revisalos antes de seguir trabajando."
    echo "================================================================"
    echo ""
fi

# Ver el comentario largo en post-merge: la config vive en la base, no en el
# archivo, asi que cambiar de rama NO cambia lo que el motor esta usando.
CONFIG=$(git diff --name-only "$PREV" "$NUEVO" -- 'tenants/*.config.yaml' 2>/dev/null)

if [ -n "$CONFIG" ]; then
    echo ""
    echo "================================================================"
    echo "  Esta rama tiene otra version de la configuracion:"
    echo "$CONFIG" | sed 's/^/    - /'
    echo ""
    echo "  Tu base sigue con la de la rama anterior. Para alinearla:"
    echo "$CONFIG" | sed 's|^|    py -3.13 cli/cargar_config.py |'
    echo "================================================================"
    echo ""
fi
